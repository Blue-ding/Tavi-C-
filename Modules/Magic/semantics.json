      "maximum": 1,
      "message": "每个法术必须恰好持有一个法术定义 Scope。"
    },
    {
      "key": "magic:spell-requires-mana-cost",
      "kind": "aspectGroupCardinality",
      "subjectElementType": "magic:spell",
      "scopeType": "magic:spell-definition",
      "aspectGroup": "magic:casting-cost",
      "minimum": 1,
      "maximum": 1,
      "aspectMustTargetScopeOwner": true,
      "message": "每个法术必须恰好声明一个基础法力消耗。"
    }
