        "magic:spell"
      ]
    }
  ],
  "aspectGroups": [
    {
      "key": "magic:mana",
      "name": "法力",
      "extensible": false
    },
    {
      "key": "magic:casting-cost",
      "name": "施法消耗",
      "extensible": false
    }
  ],
  "aspectTypes": [
    {
      "key": "magic:mana.current",
      "name": "当前法力",
