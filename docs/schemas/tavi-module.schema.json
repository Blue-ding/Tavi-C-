{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavi.local/schemas/tavi-module.schema.json",
  "title": "Tavi Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schemaVersion",
    "name",
    "dependencies"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entrypoint": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "minimumVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minimumVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "type", "defaultValue"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "type": {
            "enum": ["boolean", "integer", "number", "string"]
          },
          "defaultValue": {
            "type": "string"
          },
          "allowedValues": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          }
        }
      }
    }
  }
}
