<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Tavi.Host</RootNamespace>
    <AssemblyName>Tavi.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tavi.Abstractions\Tavi.Abstractions.csproj" />
    <ProjectReference Include="..\Tavi.Application\Tavi.Application.csproj" />
    <ProjectReference Include="..\Tavi.Domain\Tavi.Domain.csproj" />
    <ProjectReference Include="..\Tavi.Infrastructure.OpenAI\Tavi.Infrastructure.OpenAI.csproj" />
    <ProjectReference Include="..\Tavi.Infrastructure.Persistence\Tavi.Infrastructure.Persistence.csproj" />
  </ItemGroup>
  <Target Name="BuildWebForPublish" BeforeTargets="Publish">
    <!-- 发布约定：Host 始终携带由锁文件还原并重新构建的前端静态资源。 -->
    <Exec WorkingDirectory="..\Tavi.Web" Command="npm ci" />
    <Exec WorkingDirectory="..\Tavi.Web" Command="npm run build" />
  </Target>
</Project>
