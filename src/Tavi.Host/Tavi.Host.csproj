<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Tavi.Host</RootNamespace>
    <AssemblyName>Tavi.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tavi.Abstractions\Tavi.Abstractions.csproj" />
    <ProjectReference Include="..\Tavi.Application\Tavi.Application.csproj" />
    <ProjectReference Include="..\Tavi.Domain\Tavi.Domain.csproj" />
    <ProjectReference Include="..\Tavi.Infrastructure.OpenAI\Tavi.Infrastructure.OpenAI.csproj" />
    <ProjectReference Include="..\Tavi.Infrastructure.Persistence\Tavi.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\Tavi.Modules.Magic\Tavi.Modules.Magic.csproj" />
    <ProjectReference Include="..\Tavi.Runtime\Tavi.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\Modules\**\*" Link="Modules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <Target Name="BuildWebForPublish" BeforeTargets="Publish" Condition="Exists('..\Tavi.Web\package.json')">
    <!-- 发布约定：Host 始终携带由锁文件还原并重新构建的前端静态资源。 -->
    <Exec WorkingDirectory="..\Tavi.Web" Command="npm ci" />
    <Exec WorkingDirectory="..\Tavi.Web" Command="npm run build" />
  </Target>
</Project>
